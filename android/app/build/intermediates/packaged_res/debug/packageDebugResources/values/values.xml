<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="gp_splash_bg">#F8FAFC</color>
    <string name="app_name">gullacpdf</string>
    <style name="Theme.GullacPdf" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/gp_splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.GullacPdf.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/gp_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_brand_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.GullacPdf</item>
    </style>
</resources>