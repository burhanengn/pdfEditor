{
  "$schema": "https://gullacpdf.local/design-tokens.schema.json",
  "meta": {
    "brand": "gullacpdf",
    "version": "1.0.0"
  },
  "spacing": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "11": 44,
    "12": 48,
    "14": 56,
    "16": 64
  },
  "typography": {
    "titleL": { "size": 20, "lineHeight": 28, "weight": 600 },
    "titleM": { "size": 16, "lineHeight": 24, "weight": 600 },
    "body": { "size": 14, "lineHeight": 20, "weight": 400, "mobileSize": 16, "mobileLineHeight": 24 },
    "label": { "size": 13, "lineHeight": 18, "weight": 500, "mobileSize": 14, "mobileLineHeight": 20 },
    "caption": { "size": 12, "lineHeight": 16, "weight": 400 },
    "numeric": { "size": 13, "lineHeight": 18, "weight": 500 }
  },
  "components": {
    "toolbarHeightMobile": 48,
    "toolbarHeightDesktop": 56,
    "sheetRadius": 16,
    "touchTargetMin": 44,
    "primaryTouchTarget": 48,
    "handleSize": 12,
    "handleSizeCoarse": 14
  },
  "themes": {
    "light": {
      "surface": "#F8FAFC",
      "surfaceRaised": "#FFFFFF",
      "surfaceOverlay": "#FFFFFF",
      "paperBackdrop": "#E2E8F0",
      "textPrimary": "#0F172A",
      "textSecondary": "#475569",
      "textDisabled": "#94A3B8",
      "border": "#CBD5E1",
      "borderSubtle": "#E2E8F0",
      "accent": "#2563EB",
      "accentHover": "#1D4ED8",
      "accentForeground": "#FFFFFF",
      "danger": "#DC2626",
      "success": "#16A34A",
      "warning": "#D97706",
      "focusRing": "#2563EB"
    },
    "dark": {
      "surface": "#090D16",
      "surfaceRaised": "#0F172A",
      "surfaceOverlay": "#1E293B",
      "paperBackdrop": "#0F172A",
      "textPrimary": "#F8FAFC",
      "textSecondary": "#CBD5E1",
      "textDisabled": "#64748B",
      "border": "#334155",
      "borderSubtle": "#1E293B",
      "accent": "#3B82F6",
      "accentHover": "#60A5FA",
      "accentForeground": "#FFFFFF",
      "danger": "#EF4444",
      "success": "#22C55E",
      "warning": "#F59E0B",
      "focusRing": "#60A5FA"
    },
    "sepia": {
      "surface": "#2B241C",
      "surfaceRaised": "#362D23",
      "surfaceOverlay": "#42372B",
      "paperBackdrop": "#231D16",
      "textPrimary": "#FAF3E8",
      "textSecondary": "#D9C9B2",
      "textDisabled": "#8C7D6A",
      "border": "#5A4B3C",
      "borderSubtle": "#473B2E",
      "accent": "#3B82F6",
      "accentHover": "#60A5FA",
      "accentForeground": "#FFFFFF",
      "danger": "#F87171",
      "success": "#4ADE80",
      "warning": "#FBBF24",
      "focusRing": "#93C5FD"
    }
  }
}
